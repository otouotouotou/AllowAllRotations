<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 設定の受け渡しは Remote Preferences (LSPosed フレームワーク
         経由) のため、権限は不要。
         テーマは明示する: 未指定だと HyperOS 3 では標準バーが
         コンテンツに重なって画面上部が隠れるため、NoActionBar にして
         アプリ内タイトル + インセット調整で表示する -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:description="@string/module_description"
        android:theme="@style/Theme.AllowAllRotations"
        android:supportsRtl="true">

        <!-- Modern Xposed API (libxposed) ではモジュール宣言は
             AndroidManifest ではなく META-INF/xposed/module.prop、
             java_init.list、scope.list で行う。
             一覧の説明文は application の android:description が正規 -->

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
